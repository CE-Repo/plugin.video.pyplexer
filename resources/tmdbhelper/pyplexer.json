{
    "name"              : "PyPlexer",
    "plugin"            : "plugin.video.pyplexer",
    "priority"          : 200,
    "is_resolvable"     : "true",
    "assert"            : {
                            "play_movie":       ["title", "year"],
                            "play_episode":     ["title", "showname", "season", "episode"],
                            "search_movie":     ["title"],
                            "search_episode":   ["title"]
                          },
    "play_movie"        : [
                            "plugin://plugin.video.pyplexer/?mode=32&video_type=movie&query={title}&title={title}&originaltitle={originaltitle}&year={year}",
                            {"dialog": "auto"}
                          ],
    "play_episode"      : [
                            "plugin://plugin.video.pyplexer/?mode=32&video_type=episode&query={title}&showtitle={showname}&season={season}&episode={episode}",
                            {"season": "{season}", "episode": "{episode}", "dialog": "auto"}
                          ],
    "search_movie"      : [
                            "plugin://plugin.video.pyplexer/?mode=32&video_type=movie&query={title}",
                            {"dialog": "auto"}
                          ],
    "search_episode"    : [
                            "plugin://plugin.video.pyplexer/?mode=32&video_type=episode&query={title}",
                            {"dialog": "auto"}
                          ]
}
