{
    "name"              : "PyPlexer",
    "plugin"            : "plugin.video.pyplexer",
    "priority"          : 200,
    "is_resolvable"     : "true",
    "assert"            : {
                            "play_movie":       ["title", "year"],
                            "play_episode":     ["title", "showname", "season", "episode"],
                            "search_movie":     ["title"],
                            "search_episode":   ["title"]
                          },
    "fallback"          : {
                            "play_movie": "pyplexer.json search_movie",
                            "play_episode": "pyplexer.json search_episode"
                          },
    "play_movie"        : [
                            "plugin://plugin.video.pyplexer/?mode=32&video_type=movie&query={title_url}&title={title_url}&originaltitle={originaltitle_url}&year={year}&premiered={premiered}",
                            {"dialog": "auto"}
                          ],
    "play_episode"      : [
                            "plugin://plugin.video.pyplexer/?mode=32&video_type=episode&query={title_url}&showtitle={showname_url}&season={season}&episode={episode}",
                            {"season": "{season}", "episode": "{episode}", "dialog": "auto"}
                          ],
    "search_movie"      : [
                            "plugin://plugin.video.pyplexer/?mode=32&video_type=movie&query={title_url}&title={title_url}&originaltitle={originaltitle_url}&year={year}&premiered={premiered}",
                            {"dialog": "auto"}
                          ],
    "search_episode"    : [
                            "plugin://plugin.video.pyplexer/?mode=32&video_type=episode&query={title_url}&showtitle={showname_url}&season={season}&episode={episode}",
                            {"season": "{season}", "episode": "{episode}", "dialog": "auto"}
                          ]
}
